---
source: crates/gitprompt-server/tests/api_snapshots.rs
expression: "get(&api, \"/api/sources\").await"
---
[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "assistant": "Claude",
    "part_of": null,
    "layer": "Hooks",
    "summary": "Your prompts, the tools each turn used, files touched and how the turn ended.",
    "enabled": true,
    "detected": false,
    "version": "2.1.316",
    "connected": false,
    "outdated": false,
    "config_file": "[root]/home/.claude/settings.json",
    "terms": "Uses Claude Code's documented hooks feature in your own user settings. GitPrompt only receives the hook payloads Claude Code sends to it on this machine and always answers \"no output\". It does not read credentials, proxy or inspect API traffic, change your prompts, or send anything off this machine.",
    "after_connect": "",
    "blocks": [],
    "warnings": [],
    "total": 6,
    "unmapped": 0,
    "events": 2,
    "last_at": "[time]",
    "hourly": "[hourly]",
    "collects": [
      "UserPromptSubmit",
      "UserPromptExpansion",
      "PostToolUse",
      "PostToolUseFailure",
      "PermissionDenied",
      "Notification",
      "SubagentStart",
      "SubagentStop",
      "TaskCreated",
      "TaskCompleted",
      "Stop",
      "StopFailure",
      "InstructionsLoaded",
      "ConfigChange",
      "CwdChanged",
      "DirectoryAdded",
      "PreCompact",
      "PostCompact",
      "PostModelSwitch",
      "SessionEnd"
    ],
    "not_stored": {},
    "not_collected": {
      "SessionStart": "Model and start type come from the telemetry source.",
      "Setup": "Runs only command hooks.",
      "PreToolUse": "A decision point (allow or deny a tool). GitPrompt stays out of decisions; PostToolUse has the same data.",
      "PermissionRequest": "A decision point (answer a permission prompt). Notification and PermissionDenied report the outcome.",
      "PreModelSwitch": "A decision point (can block a switch). PostModelSwitch reports the change.",
      "Elicitation": "A decision point (answers an MCP server's question).",
      "ElicitationResult": "Can rewrite your answer to an MCP server; may hold values you typed into MCP forms.",
      "WorktreeCreate": "A hook here replaces Claude Code's own worktree creation.",
      "WorktreeRemove": "Only fires for worktrees that a WorktreeCreate hook made.",
      "MessageDisplay": "Fires for every streamed text chunk; Stop carries the final answer.",
      "PostToolBatch": "Repeats what PostToolUse already sends.",
      "FileChanged": "Needs a list of files to watch.",
      "TeammateIdle": "A decision point for agent teams."
    },
    "capabilities": [
      "prompt",
      "cwd",
      "turn_end",
      "answer",
      "tools",
      "subagents",
      "origin_markers",
      "transcript_path",
      "session_lifecycle"
    ],
    "needs_version": {},
    "join": "prompt_id",
    "captures": [
      {
        "id": "cli",
        "name": "CLI",
        "icon": "terminal",
        "note": "Claude Code in a terminal."
      },
      {
        "id": "vscode",
        "name": "VS Code",
        "icon": "code",
        "note": "The VS Code extension (Cursor and other VS Code forks run the same extension)."
      },
      {
        "id": "desktop",
        "name": "Desktop app",
        "icon": "app-window",
        "note": "The Code tab of Claude Desktop: it runs the hooks in ~/.claude/settings.json. Told apart from the CLI only with the telemetry layer (Desktop may only export telemetry set in managed settings: unverified for user settings)."
      },
      {
        "id": "sdk",
        "name": "SDK",
        "icon": "braces",
        "note": "claude -p and the Agent SDK (also marked as programmatic)."
      }
    ],
    "cannot_capture": {
      "Claude Desktop chat": "Chat conversations have no hooks, telemetry or local API. The only export is the account data export (Settings > Privacy, sent by email), and GitPrompt never reads the app's local storage.",
      "Cowork": "Configured through your claude.ai account, not ~/.claude, so these hooks don't run there."
    },
    "spec": {
      "name": "claude-code.yaml",
      "path": "bundled:claude-code.yaml",
      "origin": "bundled",
      "overrides": false
    },
    "spec_problem": null
  },
