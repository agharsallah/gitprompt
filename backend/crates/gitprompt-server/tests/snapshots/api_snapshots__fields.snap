  "derived": {
    "origin": "who produced the prompt: typed, slash_command, task_notification, agent_message, subagent, programmatic or unknown",
    "typed_text": "the prompt without the context blocks a tool adds before or after it (IDE selection, system reminder)",
    "injected": "the context blocks removed from the typed text: their kind (tag) and size in characters",
    "surface": "where the prompt was typed: the app or client of its tool (cli, vscode, desktop...); null when unknown",
    "stats.chars / words / lines / approx_tokens": "prompt size (tokens ≈ chars / 4)",
    "stats.slash_command": "command the prompt starts with, e.g. /review",
    "stats.at_mentions / urls / code_blocks / questions": "what the prompt references",
    "stats.secrets": "kinds of credentials found in the prompt (values never shown)",
    "summary.turn": "position of the prompt in its session",
    "summary.since_previous_prompt_s": "think time since the previous prompt of the session",
    "summary.response_s / ended_by / error": "time until Stop, StopFailure or Interrupt, and how it ended (Interrupt too when a tool call was interrupted, or the session ended first)",
    "summary.response": "the agent's final answer (the spec's `answer` events: Stop.last_assistant_message by default)",
    "summary.tool_calls / tool_failures / tool_time_s": "tools used for the prompt (PostToolUse*)",
    "summary.files_written / files_read": "file paths touched by write and read tools (a path input, or the spec's tool_files pattern)",
    "summary.bash_commands / web": "shell commands run, URLs fetched and searches made",
    "summary.mcp_tools": "MCP tools used",
    "summary.tool_kinds / tool_kind_of": "calls per kind (spec tool_kinds: read, write, shell, web, mcp, agent, other), and each tool's kind",
    "summary.subagent_tool_calls": "tool calls made by subagents (their hook payload has agent_id)",
    "summary.git_commits": "git commits the agent ran (shell commands with `git commit`)",
    "summary.tool_errors": "what the failed tool calls reported (PostToolUseFailure.error)",
    "summary.subagent_tasks": "what each subagent was asked: task name and brief (agent tools' inputs)",
    "summary.slash_command": "slash command the prompt expanded (UserPromptExpansion, or telemetry user_prompt.command_name)",
    "summary.subagents / tasks / notifications / permission_denied / compactions / model_switches": "agentic activity",
    "summary.compaction_triggers": "what started each compaction: auto (the context was full) or manual",
    "summary.errors": "errors the tool reported during the turn (ErrorOccurred): name, message, where, recoverable",
    "summary.api_requests / models / *_tokens / cost_usd / api_time_s / api_errors": "model calls (the spec's `usage` events)",
    "summary.reasoning_tokens": "output tokens spent reasoning, when the tool reports them",
    "summary.model_call_status": "model calls per status the tool reported: completed, failed, cancelled",
    "summary.model_usage": "requests, tokens and cost per model",
    "summary.work_usage": "requests, tokens and cost per query_source: the main thread, a subagent, or a system call (telemetry)",
    "summary.tool_rejections": "tool calls you rejected (telemetry)",
    "session.events / first_event_at / last_event_at": "events received for the session, by type, and when",
    "session.starts": "how the session started, then each time it was taken up again (SessionStart.source: startup, resume...)",
    "session.ended / instructions_loaded / cwd_changes / config_changes": "end reason, instruction files, directory and config changes",
    "session.modes / background": "the mode each session start reported (Cursor: composer_mode), and whether it ran as a background agent",
    "session.subagent_results": "each subagent that finished: its type, how it stopped and its last message (SubagentStop)",
    "session.metric_totals": "telemetry metric totals: lines of code, commits, active time, tokens, cost",
    "session.environment": "app version, entrypoint, terminal, OS and account (telemetry resource attributes)",
    "facts.connector": "the tool that sent the prompt: spec id, name, short name for badges, and who answers",
    "facts.surface": "where the prompt was typed: id, name and icon of the app or client (spec `surface` rules); null when unknown",
    "facts.model / model_source": "the model that answered: of the main thread's model calls, the one of most calls (usage; never a background or subagent call's model), else the model its hooks reported (hook)",
    "facts.models": "every model the turn used",
    "facts.tokens": "input, output, cache read, cache write, reasoning and total tokens; null when no model call reported any",
    "facts.cost_usd": "the turn's cost; null unless a model call reported one",
    "facts.api_requests": "model calls reported for the turn",
    "facts.outcome": "how the turn ended: done, failed, interrupted, superseded, running or open",
    "facts.permission_mode / tool_version": "as the tool reported them with the prompt",
    "facts.response_s / answered": "time until the turn ended, and whether the end carried the final answer",
    "facts.tool_calls / tool_failures / files_written / git_commits / subagents": "what the turn did",
    "commits / diffstat": "commits made after the prompt, until the next prompt of the session",
    "context.git_*": "repository state when the prompt was sent",
    "context.tool_version": "tool version when the prompt was sent"
  }
}
