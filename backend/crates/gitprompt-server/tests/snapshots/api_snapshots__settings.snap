---
source: crates/gitprompt-server/tests/api_snapshots.rs
expression: "get(&api, \"/api/settings\").await"
---
{
  "file": "[root]/gitprompt/preferences.json",
  "settings": {
    "default_range": {
      "value": "7d",
      "default": "7d",
      "source": "default",
      "env": "GITPROMPT_DEFAULT_RANGE",
      "locked": false,
      "applies": "now"
    },
    "week_start": {
      "value": "monday",
      "default": "monday",
      "source": "default",
      "env": "GITPROMPT_WEEK_START",
      "locked": false,
      "applies": "now"
