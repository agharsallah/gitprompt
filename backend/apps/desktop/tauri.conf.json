{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPrompt",
  "identifier": "com.gitprompt.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../../../web build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Capture your AI prompts locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
