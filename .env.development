# `just dev` and `just desktop-dev` (see .env for how profiles load). Yours: .env.development.local.
GITPROMPT_ENV=development
GITPROMPT_LOG_LEVEL=debug
# A data folder and port of its own keep a dev daemon apart from an installed GitPrompt (hooks keep
# sending to 7878, so it then captures nothing new):
# GITPROMPT_HOME=~/.gitprompt-dev
# GITPROMPT_PORT=7879
