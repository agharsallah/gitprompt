# Performance checks: `just perf`, `just bench` and the timing reports of `just quality` (startup,
# responsiveness, desktop). The reports set GITPROMPT_HOME, GITPROMPT_PORT and GITPROMPT_PERF_OUT
# per launch, on throwaway data; never point a performance run at your real ~/.gitprompt.
GITPROMPT_ENV=performance
# Logging costs time on the paths being measured.
GITPROMPT_LOG_LEVEL=warn
# The desktop app's own run (backend/apps/desktop/src/perf/config.rs): rounds through the sidebar's
# pages, and how long the idle app is measured.
GITPROMPT_PERF_ROUNDS=3
GITPROMPT_PERF_IDLE_SECONDS=15
# How many cold launches and relaunches `just quality desktop` times.
GITPROMPT_PERF_LAUNCHES=3
